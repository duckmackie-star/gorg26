rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'totalScore']) &&
             data.uid == request.auth.uid &&
             (!('totalScore' in data) || data.totalScore is number) &&
             (!('highScore' in data) || data.highScore is number) &&
             (!('bossDefeats' in data) || data.bossDefeats is number) &&
             (!('coins' in data) || data.coins is number) &&
             (!('unlockedModifiers' in data) || data.unlockedModifiers is list) &&
             (!('unlockedSkins' in data) || data.unlockedSkins is list) &&
             (!('selectedSkin' in data) || data.selectedSkin is string) &&
             (!('lastAIPlay' in data) || data.lastAIPlay is number) &&
             (!('upgrades' in data) || (data.upgrades is map)) &&
             (!('isVip' in data) || data.isVip is bool) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('lastActive' in data) || data.lastActive is timestamp) &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() < 100));
    }

    function isValidGameSession(data) {
      return data.keys().hasAll(['userId', 'score', 'result', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.score is number &&
             data.result in ['VICTORY', 'GAME_OVER'] &&
             (!('activeModifiers' in data) || data.activeModifiers is list);
    }

    function isValidMultiplayerRoom(data) {
      return data.keys().hasAll(['name', 'hostId', 'hostName', 'players', 'timestamp']) &&
             data.hostId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.hostName is string && data.hostName.size() <= 100 &&
             data.players is list;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "duckmackie@gmail.com" && request.auth.token.email_verified == true);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidGameSession(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /multiplayerRooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidMultiplayerRoom(request.resource.data);
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.hostId == request.auth.uid || isAdmin());
    }
  }
}
